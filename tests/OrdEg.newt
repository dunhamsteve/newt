module OrdEg
import Prelude

data Foo = A String Int | B Int | C Foo
derive Ord Foo
derive Show Ordering

data Pair a b = MkPair a b
derive ∀ a b. {{Ord a}} {{Ord b}} → Ord (Pair a b)


main : IO Unit
main = do
  printLn $ compare (A "foo" 3) (B 2)
  printLn $ compare (A "foo" 3) (A "foo" 3) 
  printLn $ compare (A "foo" 31) (A "foo" 3) 
  printLn $ compare (MkPair 1 2) (MkPair 1 3)


