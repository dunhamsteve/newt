module Lib.Derive

import Prelude
import Lib.Common
import Lib.Types
import Lib.Syntax
import Lib.TopContext
import Lib.Util

import Lib.Elab -- (lookupDCon)
import Lib.Prettier

-- describe type

data Desc : U

data DConst : U where
  MkConst : (name : String) → List (String × Desc) → DConst


data Desc : U where
  DInd : List DConst → Desc

-- So I guess we do a few of these and then figure out how to make it easier

getExplictNames : SnocList String → Tm → List String
getExplictNames acc (Pi fc (BI _ nm Explicit quant a) b) = getExplictNames (acc :< nm) b
getExplictNames acc (Pi fc _ b) = getExplictNames acc b
getExplictNames acc _ = acc <>> Nil

deriveEq : FC → Raw → Tm → M (List Decl)
deriveEq fc raw target = do
  top <- getTop
  let (a,b) = splitApp target
  let (Ref _ (QN _ name)) = a
    | _ => throwError $ E fc "\{show target} is not a type constructor application"
  let (Just (MkEntry fc q qname type (TCon _ names) eflags)) = lookupRaw name top
    | Just _ => throwError $ E fc "\{name} is not a type constructor"
    | _ => throwError $ ENotInScope fc name
  dcons <- traverse lookupDCon names
  clauses <- traverse makeClause dcons
  let fallback = (buildApp "_==_" (rvar "_" :: rvar "_" :: Nil), Just (rvar "False"))
  let eqDecl = FunDef fc "_==_" (snoc clauses fallback)
  let inst = Instance fc (buildApp "Eq" (rvar name :: Nil)) (Just $ eqDecl :: Nil)
  pure $ inst :: Nil

  where
    arr : Raw → Raw → Raw
    arr a b = RPi fc (BI fc "_" Explicit Many a) b

    rvar : String → Raw
    rvar nm = RVar fc nm

    buildApp : String → List Raw → Raw
    buildApp nm nms = foldl (\ t u => RApp fc t u Explicit) (rvar nm) $  nms

    equate : (Raw × Raw) → Raw
    equate (a,b) = buildApp "_==_" (a :: b :: Nil)

    makeClause : (QName × Int × Tm) → M (Raw × Maybe Raw)
    makeClause ((QN ns nm), _, ty) = do
      -- We're only looking at explicit args for now.
      -- TODO check quantity
      let names = getExplictNames Lin ty
      anames <- map rvar <$> traverse freshName names
      bnames <- map rvar <$> traverse freshName names
      let a = buildApp nm anames
      let b = buildApp nm bnames

      let left = equate (a,b)
      let right = case map equate $ zip anames bnames of
            Nil => rvar "True"
            (hd :: tl) => foldr (\a b => buildApp "_&&_" (a :: b :: Nil)) hd tl

      pure (left, Just right)


-- This is a little more of a pain, we'll generate a number for each constructor
-- and use that as the fallback. Eventually we'll want something like quasi-quote
deriveOrd : FC → Raw → Tm → M (List Decl)
deriveOrd fc raw target = do
  top <- getTop
  let (a,b) = splitApp target
  let (Ref _ (QN _ name)) = a
    | _ => throwError $ E fc "\{show target} is not a type constructor application"
  let (Just (MkEntry fc q qname type (TCon _ names) eflags)) = lookupRaw name top
    | Just _ => throwError $ E fc "\{name} is not a type constructor"
    | _ => throwError $ ENotInScope fc name
  let (Just target) = getTarget raw | _ => error fc "Can't sort out the type from \{show raw}"
  dcons <- traverse lookupDCon names
  clauses <- traverse makeClause dcons
  case dcons of
    [x] => do
      let compDecl = FunDef fc "compare" clauses
      let inst = Instance fc raw (Just [compDecl])
      pure $ inst :: Nil
    _ => do
      let auxDecl = TypeSig fc Many [(fc,"aux")] (arr target (rvar "Int"))
      auxClauses <- traverse makeAux $ enumerate dcons
      let auxFun = FunDef fc "aux" auxClauses
      let fallback = (buildApp "compare" [rvar "x", rvar "y"]
             , Just (RWhere fc [auxDecl,auxFun] (buildApp "compare" [buildApp "aux" [rvar "x"], buildApp "aux" [rvar "y"]])))
      let compDecl = FunDef fc "compare" (snoc clauses fallback)
      let inst = Instance fc raw (Just [compDecl])
      pure $ inst :: Nil

  where
    getTarget : Raw → Maybe Raw
    getTarget (RPi fc _ sc) = getTarget sc
    getTarget (RApp fc (RVar fc nm) u icit) = Just u
    getTarget _ = Nothing

    arr : Raw → Raw → Raw
    arr a b = RPi fc (BI fc "_" Explicit Many a) b

    rvar : String → Raw
    rvar nm = RVar fc nm


    buildApp : String → List Raw → Raw
    buildApp nm nms = foldl (\ t u => RApp fc t u Explicit) (rvar nm) $  nms

    comp : String → String → Raw
    comp x y = buildApp "compare" [rvar x, rvar y]

    -- assign a number to each constructor
    makeAux : (Nat × QName × Int × Tm) → M (Raw × Maybe Raw)
    makeAux (ix, (QN ns nm), arity, ty) = do
      let names = getExplictNames Lin ty
      anames <- map rvar <$> traverse freshName names
      let left = buildApp "aux" [buildApp nm anames]
      let right = RLit fc $ LInt $ cast ix
      pure (left, Just right)


    mkrhs : List (String × String) → Raw
    mkrhs Nil = rvar "EQ"
    mkrhs [(a,b)] = comp a b
    mkrhs ((a,b) :: x :: xs) = RCase fc (comp a b) Nothing
      [ MkAlt (rvar "EQ") (Just $ mkrhs (x :: xs))
      , MkAlt (rvar "x") (Just $ rvar "x")
      ]

    makeClause : (QName × Int × Tm) → M (Raw × Maybe Raw)
    makeClause ((QN ns nm), _, ty) = do
      -- We're only looking at explicit args for now.
      -- TODO check quantity
      let names = getExplictNames Lin ty
      anames <- traverse freshName names
      bnames <- traverse freshName names

      let a = buildApp nm (map rvar anames)
      let b = buildApp nm (map rvar bnames)
      let left = buildApp "compare" [a,b]
      let right = mkrhs $ zip anames bnames

      pure (left, Just right)


deriveShow : FC → Raw → Tm → M (List Decl)
deriveShow fc raw target = do
  top <- getTop
  let (a,b) = splitApp target
  let (Ref _ (QN _ name)) = a
    | _ => throwError $ E fc "\{show target} is not a type constructor application"
  let (Just (MkEntry fc q qname type (TCon _ names) eflags)) = lookupRaw name top
    | Just _ => throwError $ E fc "\{name} is not a type constructor"
    | _ => throwError $ ENotInScope fc name
  dcons <- traverse lookupDCon names
  clauses <- traverse makeClause dcons

  let eqDecl = FunDef fc "show" clauses
  let inst = Instance fc raw (Just $ eqDecl :: Nil)
  pure $ inst :: Nil

  where
    arr : Raw → Raw → Raw
    arr a b = RPi fc (BI fc "_" Explicit Many a) b

    rvar : String → Raw
    rvar nm = RVar fc nm

    lstring : String → Raw
    lstring s = RLit fc (LString s)

    buildApp : String → List Raw → Raw
    buildApp nm nms = foldl (\ t u => RApp fc t u Explicit) (rvar nm) $  nms

    equate : (Raw × Raw) → Raw
    equate (a,b) = buildApp "_==_" (a :: b :: Nil)

    makeList : List Raw → Raw
    makeList Nil = rvar "Nil"
    makeList (x :: xs) = buildApp "_::_" (x :: makeList xs :: Nil)

    makeClause : (QName × Int × Tm) → M (Raw × Maybe Raw)
    makeClause ((QN ns nm), _, ty) = do
      let names = getExplictNames Lin ty
      anames <- map rvar <$> traverse freshName names
      let left = buildApp "show" $ buildApp nm anames :: Nil
      let shows = map (\ nm => RApp fc (rvar "show") nm Explicit) anames
      let right = case anames of
            Nil => lstring nm
            _ =>
              let parts = makeList $ lstring ("(" ++ nm) :: shows in
              buildApp "_++_" $ buildApp "joinBy" (lstring " " :: parts :: Nil)  :: lstring ")" :: Nil

      pure (left, Just right)

expandDerive : FC → Raw → M (List Decl)
expandDerive fc raw = do
  top <- getTop
  ty <- check (mkCtx fc Zero) raw (VU fc)
  let (codomain, tele) = splitTele ty
  let (Just (clName, target)) = getKind codomain
    | _ => error (getFC codomain) "Expected Eq or Show application"
  case clName of
    "Eq" => deriveEq fc raw target
    "Show" => deriveShow fc raw target
    "Ord" =>  deriveOrd fc raw target
    _ => error fc "derive \{clName} is not supported"
  where
    getKind : Tm -> Maybe (String × Tm)
    getKind (App _ (Ref _ name) u _) = Just (name.baseName, u)
    getKind (_) = Nothing
